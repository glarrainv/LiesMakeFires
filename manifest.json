{
  "manifest_version": 3,
  "name": "Lies Make Fires - Environmental fact checker",
  "short_name": "Climate fact checker",
  "description": "The fact checking extension for environmental research; stopping climate misinformation.",
  "version": "2.1.0",
  "version_name": "2.1.0 BETA",
   "icons": {
   "128": "ico128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
    "content_scripts": [
        {
        "matches": ["*://www.google.com/search*"],
        "js": ["content.js"]
        }
    ],
  "permissions": ["offscreen"],
  "host_permissions": ["*://www.google.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["sampleStructures/googleItem.html"],
      "matches": ["*://www.google.com/*"]
    }
  ],
  "content_security_policy": {
  "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
}
}